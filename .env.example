# ─────────────────────────────────────────────────────────────────────────────
# PetezPopz Mobile App — Environment Template (2026-04 Architecture)
# Copy this file to .env and fill in the values marked REQUIRED.
# ─────────────────────────────────────────────────────────────────────────────
#
# MODERN HEADLESS ARCHITECTURE (2026-04):
# ──────────────────────────────────────────────────────────────────────────────
# There is NO static storefront access token in this project.
# Shopify's 2026-04 headless model uses a unified GraphQL endpoint for both
# public catalog access and authenticated customer access:
#
#   Public (products, collections, cart):
#     Headers: Shopify-Store-Domain + Shopify-Client-Id
#
#   Authenticated (customer profile, orders, loyalty metafields):
#     Headers: above + Authorization: Bearer {pkce_access_token}
#
# Metafield access is governed by shopify.extension.toml [[extensions.metafields]].
# Deprecated patterns (DO NOT introduce these):
#   ✗ unauthenticated_read_product_listings
#   ✗ unauthenticated_write_checkouts
#   ✗ X-Shopify-Storefront-Access-Token header
#   ✗ SHOPIFY_CLIENT_SECRET in any client bundle
# ─────────────────────────────────────────────────────────────────────────────

# ── Shopify Store ─────────────────────────────────────────────────────────────

# REQUIRED — Your myshopify.com domain (without https://)
EXPO_PUBLIC_SHOPIFY_STORE_DOMAIN=gemcitytoyco.myshopify.com

# API version — must match shopify.app.toml and shopify.extension.toml
EXPO_PUBLIC_SHOPIFY_STOREFRONT_API_VERSION=2026-04

# ── Customer Account API (PKCE OAuth) ─────────────────────────────────────────

# REQUIRED — Public client ID from your Shopify app (safe to bundle)
# Location: Shopify Partner Dashboard → Apps → your app → Client credentials
EXPO_PUBLIC_SHOPIFY_CUSTOMER_CLIENT_ID=b2686c7d161c4dd5e2b99337d214e56b

# OAuth redirect URI — must match shopify.app.toml [auth] redirect_urls
EXPO_PUBLIC_SHOPIFY_OAUTH_REDIRECT_URI=petezpopz://auth/callback

# OAuth authentication base URL (PKCE authorize/token/revoke endpoints)
EXPO_PUBLIC_SHOPIFY_CUSTOMER_API_URL=https://shopify.com/authentication/gemcitytoyco/oauth

# Unified GraphQL endpoint — handles both public catalog + authenticated queries
EXPO_PUBLIC_SHOPIFY_CUSTOMER_GRAPHQL_URL=https://shopify.com/api/2026-04/graphql

# ── App Identity ──────────────────────────────────────────────────────────────

EXPO_PUBLIC_APP_NAME=PetezPopz

# ── Loyalty Configuration ─────────────────────────────────────────────────────

EXPO_PUBLIC_LOYALTY_EARN_RATE=1
EXPO_PUBLIC_LOYALTY_REDEMPTION_POINTS=100
EXPO_PUBLIC_LOYALTY_REDEMPTION_VALUE=5
EXPO_PUBLIC_VIP_THRESHOLD_POINTS=500

# ─────────────────────────────────────────────────────────────────────────────
# SERVER-SIDE ONLY (webhook handler — NOT in this mobile app)
# ─────────────────────────────────────────────────────────────────────────────
# SHOPIFY_CLIENT_SECRET is used exclusively by your server-side webhook handler
# to verify HMAC signatures from Shopify Flow. It is never present in the app
# binary. Add it only to your server (Vercel, Railway, etc.) environment.
#
# SHOPIFY_WEBHOOK_SECRET=shpss_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
