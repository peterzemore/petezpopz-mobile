# ─────────────────────────────────────────────────────────────────────────────
# PetezPopz Mobile App — Environment Template
# Copy this file to .env and fill in the values marked REQUIRED.
# ─────────────────────────────────────────────────────────────────────────────
#
# ARCHITECTURE:
# ──────────────────────────────────────────────────────────────────────────────
#   Public catalog (products, collections, cart):
#     Classic per-store Storefront API — POST https://{store}/api/{version}/graphql.json
#     Header: X-Shopify-Storefront-Access-Token (public Storefront API token)
#
#   Authenticated customer (profile, orders, loyalty metafields):
#     Customer Account API (OAuth PKCE) — POST {customer graphql url}
#     Headers: Authorization: Bearer {pkce_access_token}
#              + Shopify-Store-Domain, Shopify-Client-Id
#
# NEVER put a private/Admin API token (shpat_...) in this file or anywhere in
# the mobile app bundle — it grants full store access. Admin API calls (e.g.
# the barcode lookup) must go through the server-side proxy in barcode-proxy/,
# which reads SHOPIFY_ADMIN_TOKEN from its own server environment (Vercel), not
# from this app.
# ─────────────────────────────────────────────────────────────────────────────

# ── Shopify Store ─────────────────────────────────────────────────────────────

# REQUIRED — Your myshopify.com domain (without https://)
EXPO_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# REQUIRED — Public Storefront API access token
# Location: Shopify Admin → Settings → Apps and sales channels → Develop apps →
#           your app → API credentials → Storefront API access token
EXPO_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN=your-storefront-public-access-token

# Storefront API version
EXPO_PUBLIC_SHOPIFY_STOREFRONT_API_VERSION=2026-04

# ── Customer Account API (PKCE OAuth) ─────────────────────────────────────────

# REQUIRED — Client ID from your Customer Account API credentials (safe to bundle)
EXPO_PUBLIC_SHOPIFY_CUSTOMER_CLIENT_ID=your-customer-account-client-id

# REQUIRED — Callback URI. Must exactly match the "Callback URI" configured in
# the Customer Account API credentials — a custom app scheme, not a web URL.
EXPO_PUBLIC_SHOPIFY_OAUTH_REDIRECT_URI=shop.your-shop-id.app://callback

# REQUIRED — Base URL for the authorize/token endpoints (no trailing slash;
# "/authorize" and "/token" are appended automatically)
EXPO_PUBLIC_SHOPIFY_CUSTOMER_API_URL=https://account.yourdomain.com/authentication/oauth

# REQUIRED — Logout/session-revocation endpoint
EXPO_PUBLIC_SHOPIFY_LOGOUT_ENDPOINT=https://account.yourdomain.com/authentication/logout

# REQUIRED — Customer Account GraphQL endpoint
EXPO_PUBLIC_SHOPIFY_CUSTOMER_GRAPHQL_URL=https://account.yourdomain.com/customer/api/2026-04/graphql

# ── Barcode scanner (optional) ────────────────────────────────────────────────
# URL of the barcode-proxy Vercel deployment (see barcode-proxy/). Leave blank
# to fall back to direct Storefront search by barcode.
EXPO_PUBLIC_BARCODE_API_URL=

# ── Account deletion (REQUIRED once account deletion ships — App Store requires
# any app supporting account creation to also support in-app account deletion) ──
# URL of the barcode-proxy Vercel deployment's delete-account endpoint.
EXPO_PUBLIC_DELETE_ACCOUNT_URL=
# Server-side loyalty redemption (barcode-proxy/api/redeem-points.js).
EXPO_PUBLIC_REDEEM_POINTS_URL=

# Marketing opt-in (barcode-proxy/api/subscribe-marketing.js). Lets a signed-in
# customer subscribe from inside the app, which is what unlocks the free Silver
# tier — the membership service promotes them once Shopify records consent.
EXPO_PUBLIC_SUBSCRIBE_MARKETING_URL=

# ── Crash reporting (optional but recommended) ────────────────────────────────
# DSN from a free project at sentry.io (Settings → Client Keys (DSN)). Without
# this, the app runs fine but crashes/errors aren't reported anywhere.
EXPO_PUBLIC_SENTRY_DSN=

# ── App Identity ──────────────────────────────────────────────────────────────

EXPO_PUBLIC_APP_NAME=PetezPopz

# ── Loyalty Configuration ─────────────────────────────────────────────────────

EXPO_PUBLIC_LOYALTY_EARN_RATE=1
EXPO_PUBLIC_LOYALTY_REDEMPTION_POINTS=100
EXPO_PUBLIC_LOYALTY_REDEMPTION_VALUE=5
# ── Membership tiers ──────────────────────────────────────────────────────────
# The spend-based VIP tier was retired on 2026-08-03 in favour of paid
# memberships. Tier comes from the custom.membership_tier metafield, written by
# the membership service (~/Desktop/petezpopz-membership), and the rates live in
# MEMBERSHIPS in src/api/queries/customer.ts — not in env vars, because they
# must stay in lockstep with the Shopify automatic discounts:
#
#   Guest     no marketing consent yet — no perks
#   Silver    free, earned by opting into email or SMS
#   Gold      $14.99/mo — 10% off, free shipping over $79
#   Platinum  $24.99/mo — 12% off, free shipping over $79, early access

# ─────────────────────────────────────────────────────────────────────────────
# SERVER-SIDE ONLY — never put these in this file or the mobile app bundle
# ─────────────────────────────────────────────────────────────────────────────
# barcode-proxy/ (deployed separately to Vercel) needs its own env vars:
#   SHOPIFY_STORE                 → your-store.myshopify.com
#   SHOPIFY_CLIENT_ID             → Dev Dashboard app client id
#   SHOPIFY_CLIENT_SECRET         → Dev Dashboard app client secret
#                                   (admin-created custom apps were deprecated
#                                    2026-01-01; tokens are now exchanged via the
#                                    client credentials grant and expire in 24h)
#   SHOPIFY_CUSTOMER_GRAPHQL_URL  → https://account.yourdomain.com/customer/api/2026-07/graphql
#                                   (needed by delete-account.js to verify the caller's identity)
