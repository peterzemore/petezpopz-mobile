{
  "expo": {
    "name": "PetezPopz",
    "slug": "petezpopz",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0A12",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A12"
    },
    "scheme": "petezpopz",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.petezpopz.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "PetezPopz needs camera access to scan product barcodes.",
        "NSFaceIDUsageDescription": "PetezPopz uses Face ID to securely sign you into your collector account.",
        "NSPhotoLibraryUsageDescription": "PetezPopz may access photos to update your profile."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0A12"
      },
      "package": "com.petezpopz.app",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "VIBRATE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.CAMERA"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "fonts": [
            "node_modules/@expo-google-fonts/outfit/Outfit_400Regular.ttf",
            "node_modules/@expo-google-fonts/outfit/Outfit_500Medium.ttf",
            "node_modules/@expo-google-fonts/outfit/Outfit_600SemiBold.ttf",
            "node_modules/@expo-google-fonts/outfit/Outfit_700Bold.ttf",
            "node_modules/@expo-google-fonts/outfit/Outfit_900Black.ttf",
            "node_modules/@expo-google-fonts/inter/Inter_400Regular.ttf",
            "node_modules/@expo-google-fonts/inter/Inter_500Medium.ttf",
            "node_modules/@expo-google-fonts/inter/Inter_600SemiBold.ttf",
            "node_modules/@expo-google-fonts/inter/Inter_700Bold.ttf"
          ]
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow PetezPopz to use Face ID for secure sign-in."
        }
      ],
      "expo-secure-store",
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "PetezPopz needs camera access to scan product barcodes.",
          "enableMicrophonePermission": false
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a31ce02b-59a4-4163-81b0-5fb9091f23ba"
      }
    }
  }
}
