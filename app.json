{
  "expo": {
    "name": "PetezPopz",
    "slug": "petezpopz",
    "platforms": [
      "ios",
      "android"
    ],
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0A12",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A12"
    },
    "scheme": [
      "shop.55261102144.app",
      "petezpopz"
    ],
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "bundleIdentifier": "com.petezpopz.app",
      "supportsTablet": true,
      "buildNumber": "7",
      "infoPlist": {
        "NSCameraUsageDescription": "PetezPopz needs camera access to scan product barcodes.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0A12"
      },
      "package": "com.petezpopz.app",
      "versionCode": 3,
      "permissions": [
        "CAMERA",
        "VIBRATE"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.0"
          }
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "node_modules/@expo-google-fonts/outfit/Outfit_400Regular.ttf",
            "node_modules/@expo-google-fonts/outfit/Outfit_500Medium.ttf",
            "node_modules/@expo-google-fonts/outfit/Outfit_600SemiBold.ttf",
            "node_modules/@expo-google-fonts/outfit/Outfit_700Bold.ttf",
            "node_modules/@expo-google-fonts/outfit/Outfit_900Black.ttf",
            "node_modules/@expo-google-fonts/inter/Inter_400Regular.ttf",
            "node_modules/@expo-google-fonts/inter/Inter_500Medium.ttf",
            "node_modules/@expo-google-fonts/inter/Inter_600SemiBold.ttf",
            "node_modules/@expo-google-fonts/inter/Inter_700Bold.ttf"
          ]
        }
      ],
      "expo-secure-store",
      "expo-asset",
      "react-native-vision-camera",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "organization": "petez-popz-llc",
          "project": "react-native"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a31ce02b-59a4-4163-81b0-5fb9091f23ba"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/a31ce02b-59a4-4163-81b0-5fb9091f23ba"
    }
  }
}
